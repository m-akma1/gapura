# Copy to .env before docker compose up. 
# Generate secrets with openssl rand -base64 32

# Postgres
POSTGRES_USER=gapura
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=gapura
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# Canonical hostnames
AUTH_ISSUER=http://auth.gapura.test
KERATON_BASE_URL=http://keraton.gapura.test
JOGLO_BASE_URL=http://joglo.gapura.test

# User seed (administrators group)
SEED_ADMIN_NAME="Atmint Solo"
SEED_ADMIN_EMAIL=admin@gapura.test
SEED_ADMIN_PASSWORD=change-me-admin-password

# OAuth clients
KERATON_CLIENT_ID=keraton-web
KERATON_CLIENT_SECRET=change-me-keraton-secret
JOGLO_CLIENT_ID=joglo-web
JOGLO_CLIENT_SECRET=change-me-joglo-secret

# Sync worker to application signing
LOGOUT_SIGNING_SECRET_KERATON=change-me-keraton-signing-secret
LOGOUT_SIGNING_SECRET_JOGLO=change-me-joglo-signing-secret

# Lifetimes
AUTH_CODE_TTL_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=300
CENTRAL_SESSION_TTL_SECONDS=28800
LOCAL_SESSION_TTL_SECONDS=3600

# Comment the above line and uncomment this
# for demo lifetime values

# AUTH_CODE_TTL_SECONDS=60
# ACCESS_TOKEN_TTL_SECONDS=300
# CENTRAL_SESSION_TTL_SECONDS=600
# LOCAL_SESSION_TTL_SECONDS=180
# LOG_LEVEL=debug

# Outbox and delivery
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
DELIVERY_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=info
