<article style="max-width: 26rem; margin-inline: auto">
  <header><strong>Sign in to Gapura</strong></header>
  <% if (it.error) { %>
    <p role="alert" style="color: var(--pico-del-color)"><%= it.error %></p>
  <% } %>
  <form method="post" action="/login">
    <% if (it.next) { %><input type="hidden" name="next" value="<%= it.next %>"><% } %>
    <label>
      Email
      <input type="email" name="email" value="<%= it.email %>" required autofocus autocomplete="username">
    </label>
    <label>
      Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit">Sign in</button>
  </form>
</article>
