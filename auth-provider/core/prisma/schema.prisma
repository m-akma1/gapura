// The gapura database: the auth provider's primary store.
// Shared by three processes (server, control-panel, sync-worker)

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

enum ApplicationStatus {
  active
  inactive
}

enum SessionStatus {
  active
  expired
  revoked
}

enum TokenStatus {
  active
  expired
  revoked
}

enum PolicyEffect {
  allow
}

enum EventStatus {
  pending
  published
  failed
}

enum DeliveryStatus {
  pending
  processing
  succeeded
  retrying
  failed
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships        UserGroup[]
  ssoSessions        SsoSession[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  events             Event[]

  @@map("users")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  UserGroup[]
  policies ApplicationGroupPolicy[]

  @@map("groups")
}

model UserGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("user_groups")
}

model Application {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  clientId              String            @unique @map("client_id")
  clientSecretHash      String?           @map("client_secret_hash")
  status                ApplicationStatus @default(active)
  launchUrl             String?           @map("launch_url")
  logoutNotificationUrl String            @map("logout_notification_url")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  redirectUris       ApplicationRedirectUri[]
  policies           ApplicationGroupPolicy[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  events             Event[]
  deliveries         EventDelivery[]

  @@map("applications")
}

model ApplicationRedirectUri {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  redirectUri   String   @map("redirect_uri")
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, redirectUri])
  @@map("application_redirect_uris")
}

model ApplicationGroupPolicy {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  groupId       String       @map("group_id") @db.Uuid
  effect        PolicyEffect @default(allow)
  createdAt     DateTime     @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([applicationId, groupId, effect])
  @@map("application_group_policies")
}

model SsoSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  sessionTokenHash String        @unique @map("session_token_hash")
  status           SessionStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at")
  expiresAt        DateTime      @map("expires_at")
  lastActivityAt   DateTime?     @map("last_activity_at")
  revokedAt        DateTime?     @map("revoked_at")
  revokeReason     String?       @map("revoke_reason")
  ipAddress        String?       @map("ip_address")
  userAgent        String?       @map("user_agent")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]

  @@index([userId, status])
  @@map("sso_sessions")
}

model AuthorizationCode {
  id            String    @id @default(uuid()) @db.Uuid
  codeHash      String    @unique @map("code_hash")
  userId        String    @map("user_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  ssoSessionId  String    @map("sso_session_id") @db.Uuid
  redirectUri   String    @map("redirect_uri")
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ssoSession  SsoSession  @relation(fields: [ssoSessionId], references: [id], onDelete: Cascade)

  @@map("authorization_codes")
}

model AccessToken {
  id            String      @id @default(uuid()) @db.Uuid
  tokenHash     String      @unique @map("token_hash")
  userId        String      @map("user_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  ssoSessionId  String      @map("sso_session_id") @db.Uuid
  scopes        Json?
  status        TokenStatus @default(active)
  issuedAt      DateTime    @default(now()) @map("issued_at")
  expiresAt     DateTime    @map("expires_at")
  revokedAt     DateTime?   @map("revoked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ssoSession  SsoSession  @relation(fields: [ssoSessionId], references: [id], onDelete: Cascade)

  // Revoking a session revokes its tokens in the same transaction, so this is a
  // hot path.
  @@index([ssoSessionId, status])
  @@map("access_tokens")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String   @map("event_type")
  actorId       String?  @map("actor_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  result        String
  metadata      Json?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  // Deliberately unconstrained: an audit row must survive deletion of whatever
  // it refers to.
  @@index([createdAt])
  @@map("audit_logs")
}

model Event {
  id               String      @id @default(uuid()) @db.Uuid
  eventType        String      @map("event_type")
  userId           String      @map("user_id") @db.Uuid
  centralSessionId String?     @map("central_session_id") @db.Uuid
  applicationId    String?     @map("application_id") @db.Uuid
  payload          Json
  status           EventStatus @default(pending)
  createdAt        DateTime    @default(now()) @map("created_at")
  publishedAt      DateTime?   @map("published_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application?    @relation(fields: [applicationId], references: [id])
  deliveries  EventDelivery[]

  // The relay's claim query filters on status and orders by creation.
  @@index([status, createdAt])
  @@map("events")
}

model EventDelivery {
  id            String         @id @default(uuid()) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  status        DeliveryStatus @default(pending)
  attemptCount  Int            @default(0) @map("attempt_count")
  lastAttemptAt DateTime?      @map("last_attempt_at")
  nextRetryAt   DateTime?      @map("next_retry_at")
  processedAt   DateTime?      @map("processed_at")
  lastError     String?        @map("last_error")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // One row per event per target app. The pair is unique so a redelivery cannot
  // create a second row.
  @@unique([eventId, applicationId])
  @@map("event_deliveries")
}
