<article>
  <header><strong><%= it.rotated ? "Secret regenerated" : "Application registered" %></strong></header>
  <p><%= it.name %> - <code><%= it.clientId %></code></p>
  <p><strong>Copy this secret now. It is shown once and cannot be retrieved.</strong></p>
  <pre><code><%= it.secret %></code></pre>
  <footer>
    <a href="/admin/applications/<%= it.applicationId %>" role="button">Continue</a>
  </footer>
</article>
